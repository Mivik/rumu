{
  "name": "rumu-web",
  "private": true,
  "version": "0.1.0",
  "description": "The rumu web UI — quiet, considered, and out of your way.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mivik/rumu.git",
    "directory": "web"
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate && node scripts/build-sw.mjs",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "mock": "cd .. && RUMU_HOME=web/mock/home RUMU_LLM=script:web/mock/demo.yaml cargo run -p rumu-server"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/red-hat-text": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "dompurify": "^3.4.18",
    "fuzzysort": "^4.0.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "marked": "^18.2.0",
    "marked-cjk-friendly": "^0.1.3",
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.20",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vue-tsc": "^3.3.14"
  }
}
